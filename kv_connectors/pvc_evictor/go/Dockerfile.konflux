# Go build stage
FROM registry.access.redhat.com/ubi9/go-toolset:1.26.10-1793232557@sha256:a3b89f072fe0704b9388f3c9ad5681a6cf16293324e3f25ca0107bc09217cf62 AS go-builder

ARG TARGETOS
ARG TARGETARCH

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/

USER root
RUN mkdir -p bin && chown 1001:0 bin
USER 1001

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o bin/pvc-evictor \
    ./cmd/pvc-evictor

# Runtime stage
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8-1793092152@sha256:72187ec58a94bd958ff48e41881d7c5d8bc0b49586cc1661da5ba4d92374c206

WORKDIR /

COPY --from=go-builder --chown=65532:65532 /workspace/bin/pvc-evictor /app/pvc-evictor

USER 65532:65532

ENTRYPOINT ["/app/pvc-evictor"]

LABEL com.redhat.component="odh-llm-d-kv-pvc-evictor-rhel9" \
      name="odh-llm-d-kv-pvc-evictor-rhel9" \
      description="odh-llm-d-kv-pvc-evictor" \
      summary="odh-llm-d-kv-pvc-evictor" \
      io.k8s.display-name="odh-llm-d-kv-pvc-evictor" \
      io.k8s.description="odh-llm-d-kv-pvc-evictor"

# Go build stage
FROM registry.access.redhat.com/ubi9/go-toolset:1.26.10-1792906297@sha256:c51f0f31cbaa7e91dede6013f636d54fe10dd7d581cfc4cda014ba9d62bcd779 AS go-builder

ARG TARGETOS
ARG TARGETARCH

ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

WORKDIR /workspace

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY internal/ internal/

USER root
RUN mkdir -p bin && chown 1001:0 bin
USER 1001

RUN GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags="-s -w" \
    -o bin/pvc-evictor \
    ./cmd/pvc-evictor

# Runtime stage
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:9.8-1793018125@sha256:f9a3f225bc0e265827d123f0e07a9f7ae5686d0cb61fa85e55fc589240543d3f

WORKDIR /

COPY --from=go-builder --chown=65532:65532 /workspace/bin/pvc-evictor /app/pvc-evictor

USER 65532:65532

ENTRYPOINT ["/app/pvc-evictor"]

LABEL com.redhat.component="odh-llm-d-kv-pvc-evictor-rhel9" \
      name="odh-llm-d-kv-pvc-evictor-rhel9" \
      description="odh-llm-d-kv-pvc-evictor" \
      summary="odh-llm-d-kv-pvc-evictor" \
      io.k8s.display-name="odh-llm-d-kv-pvc-evictor" \
      io.k8s.description="odh-llm-d-kv-pvc-evictor"
